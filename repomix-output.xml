                )

            input("\nPresione ENTER para continuar...")
            return True

        # 3. FILTRAR CANCIONES
        elif opcion == "3":
            self.limpiar_pantalla()
            print("--- FILTRAR CANCIONES ---")
            valor = input(
                "Ingrese criterio (ej. Electropop, Clasica, Desamor, 2025): "
            ).strip()

            if valor:
                resultados = []

                def normalizar(texto):
                    if not texto:
                        return ""
                    m = str(texto).lower()
                    for orig, reemp in [
                        ("á", "a"),
                        ("é", "e"),
                        ("í", "i"),
                        ("ó", "o"),
                        ("ú", "u"),
                    ]:
                        m = m.replace(orig, reemp)
                    return m

                busqueda = normalizar(valor)

                todas = []
