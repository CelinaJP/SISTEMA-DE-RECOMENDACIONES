        self.arbol.insertar("Pop", Cancion(1, "Bailarina", "Miranda!"))
        self.assertFalse(self.arbol.existe("Rock"))

    # --- Recorridos con varios elementos ---

    def test_inorder_queda_alfabeticamente_ordenado(self):
