        heap = MaxHeap(key=lambda x: x)
        heap.insertar(10)
        heap.insertar(50)
        heap.insertar(20)

        self.assertEqual(heap.extraer_maximo(), 50)
        self.assertEqual(heap.extraer_maximo(), 20)
        self.assertEqual(heap.extraer_maximo(), 10)
