                    texto_cancion = []
                    for v in valores:
                        if isinstance(v, list):
                            texto_cancion.append(" ".join(map(str, v)))
                        elif v is not None:
                            texto_cancion.append(str(v))

                    cadena_buscar = normalizar(" ".join(texto_cancion))

                    if busqueda in cadena_buscar:
                        resultados.append(c)

                if resultados:
